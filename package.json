{
  "name": "next-tutorial-bbs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "dotenv -e .env.test -- vitest run",
    "test:dev": "dotenv -e .env.test -- vitest dev",
    "test:watch": "dotenv -e .env.test -- vitest watch",
    "test:cov": "dotenv -e .env.test -- vitest run --coverage",
    "test:e2e": "set NODE_ENV=test&& dotenv -e .env.test npx playwright test e2e/bbs.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test:db": "dotenv -e .env.test -- vitest run src/lib/bbs/__tests__/bbs-data-fetcher.boards.test.ts",
    "test:setup": "docker compose up -d test-db && set NODE_ENV=test&& dotenv -e .env.test -- npx prisma migrate deploy",
    "test:teardown": "docker compose down --volumes",
    "test:integration": "npm run test:setup && npm run test:db && npm run test:teardown",
    "migrate:test": "dotenv -e .env.test -- npx prisma migrate deploy",
    "seed:test": "dotenv -e .env.test -- tsx ./prisma/seed.ts",
    "test:server": "set NODE_ENV=test&& dotenv -e .env.test -- next dev -p 3001"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@conform-to/react": "^1.8.2",
    "@conform-to/zod": "^1.8.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-visually-hidden": "^1.1.2",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "next": "^15.4.5",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "prisma": "^6.6.0",
    "radix-ui": "^1.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "server-only": "^0.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
